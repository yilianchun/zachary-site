---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const resources = (await getCollection('docs'))
  .sort((a, b) => a.data.group.localeCompare(b.data.group, 'zh-CN'));

const groups = Array.from(new Set(resources.map((resource) => resource.data.group)));
---

<BaseLayout title="Docs" description="Zachary 的资源站。">
  <section class="page-block" aria-labelledby="docs-title">
    <p class="page-kicker">docs / resources</p>
    <h1 class="page-title" id="docs-title">Docs</h1>
    <p class="page-lead">这里会整理学习资料、研究工具、效率应用和一些值得长期保存的链接。先有索引，内容之后慢慢补。</p>

    {groups.map((group) => {
      const groupResources = resources.filter((resource) => resource.data.group === group);

      return (
        <section class="resource-section" aria-labelledby={`docs-${group}`}>
          <div class="resource-heading">
            <h2 id={`docs-${group}`}>{group}</h2>
            <span>{groupResources.length} item{groupResources.length > 1 ? 's' : ''}</span>
          </div>
          <ul class="resource-grid" aria-label={`${group} 资源列表`}>
            {groupResources.map((resource) => (
              <li class="resource-item">
                <p class="resource-group">{resource.data.tags.join(' / ')}</p>
                <h2><a href={resource.data.url} target="_blank" rel="noreferrer">{resource.data.title}</a></h2>
                <p>{resource.data.description}</p>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
  </section>
</BaseLayout>