---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="页面不存在。">
  <section class="page-block" aria-labelledby="not-found-title">
    <p class="page-kicker">404 / not found</p>
    <h1 class="page-title" id="not-found-title">Lost?</h1>
    <p class="page-lead">这个页面还没有出现。可以回到首页，或者从 Blog、Docs、Life 重新进入。</p>
    <nav class="section-nav" aria-label="404 导航">
      <a href="/">Home</a>
      <a href="/blog/">Blog</a>
      <a href="/docs/">Docs</a>
      <a href="/life/">Life</a>
    </nav>
  </section>
</BaseLayout>