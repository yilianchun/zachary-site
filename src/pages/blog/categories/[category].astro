---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { sameTaxonomy, sortPosts, taxonomySlug, uniqueValues } from '../../../utils/blog';
import { entrySlug, formatDate } from '../../../utils/content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const categories = uniqueValues(posts.map((post) => post.data.category));

  return categories.map((category) => ({
    params: { category: taxonomySlug(category) },
    props: { category },
  }));
}

const { category } = Astro.props;
const posts = sortPosts((await getCollection('blog', ({ data }) => !data.draft))
  .filter((post) => sameTaxonomy(post.data.category, category)));
---

<BaseLayout title={`分类：${category}`} description={`Zachary 博客中 ${category} 分类的文章。`}>
  <section class="page-block" aria-labelledby="category-title">
    <p class="page-kicker">blog / category</p>
    <h1 class="page-title" id="category-title">{category}</h1>
    <p class="page-lead">这个分类下的文章。</p>
    <ul class="content-list" aria-label={`${category} 分类下的文章`}>
      {posts.map((post) => (
        <li class="content-row">
          <div class="content-meta">{formatDate(post.data.date)}</div>
          <div>
            <h2 class="content-title"><a href={`/blog/${entrySlug(post.id)}/`}>{post.data.title}</a></h2>
            <p class="content-summary">{post.data.summary}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>